  "rules": {
    "stableIdentity": "Persist worldSeed + npcId; appearance must not change on LOD or pool reassignment.",
    "minimumTen": "Shuffle all 10 preset IDs without replacement for the first 10 NPCs, then generate within theme; a random sample alone does not guarantee ten unique NPCs.",
    "hatFit": "A01 only uses authored R04_cap or R03_cap hair variant; never overlay full hair under cap.",
    "headFit": "Hair, beard and glasses need per-head fit offsets or authored variants; image claims of universal fit are design intentions, not verification.",
    "bodyFit": "standard/slim/broad/soft use corresponding authored garment fits on the same reference skeleton.",
    "hemFit": "P04 requires boot-compatible hem for S04/S05. P01/P02/P03 use low-shoe hems.",
    "expression": "E06 is a transient blink action. Identity and emotion are separate; do not freeze blink as personality.",
    "themeBias": "Theme controls clothing and context; skin, gender presentation and head shape are not tied to occupation.",
    "morphSync": "All body and garment fit shapes must use the same parameter values.",
    "material": "T01 stripe and solid are material variants; C06 hair silhouette needs fitting R01 to the lineup.",
    "scope": "Presets are curated design recipes. Broader combinatorial variants require 3D compatibility validation."
  }
